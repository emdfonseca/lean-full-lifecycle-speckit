{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "families",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "families": {
      "description": "Allowlist. Adding a family is a deliberate act, not a typo.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z]+$"
      }
    },
    "gates": {
      "description": "Release gates that cannot be derived from requirement status.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "release",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "release": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "met"
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "priority",
        "release",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-[A-Z0-9]+-[0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "components": {
          "description": "Refs resolved against the inventory, policy files, or the check registry.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(workflow|preset|extension|command|policy|check|script):[A-Za-z0-9._/-]+$"
          }
        },
        "verified_by": {
          "description": "pytest node ids. Required once status is implemented or verified.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tests/.+::.+"
          }
        }
      }
    }
  }
}
